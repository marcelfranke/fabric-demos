# Copy to .env for local runs. Never commit .env.
# This file holds switches only. There are no secrets here and none belong here:
# Azure access comes from DefaultAzureCredential after `az login` (rule 6).

# Which config/env.<name>.yaml the scripts read when --env is not given.
HUBDEMO_ENV=demo

# Set to 1 to run the tests marked live or security. They need cloud resources.
HUBDEMO_LIVE=0

# Optional. Only set these when DefaultAzureCredential picks the wrong tenant or
# subscription. They are identifiers, not credentials.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
