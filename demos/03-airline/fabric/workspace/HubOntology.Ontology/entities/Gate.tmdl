/// A gate in a concourse of the hub.
entity Gate
	lineageTag: 9c2e1b43-5d4e-4b1f-8a30-1b2c3d4e0202
	backingTable: gates
	keyProperty: GateIdentifier

	property GateIdentifier
		dataType: string

		backingConfiguration
			valueColumn: gates.gate_id

	/// The concourse the gate belongs to.
	property Concourse
		dataType: string

		backingConfiguration
			valueColumn: gates.concourse
