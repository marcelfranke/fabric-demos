/// A checked bag that has to be moved from an arriving flight to a departing flight.
entity Bag
	lineageTag: 9c2e1b43-5d4e-4b1f-8a30-1b2c3d4e0206
	backingTable: bags
	keyProperty: BagTag

	property BagTag
		dataType: string

		backingConfiguration
			valueColumn: bags.bag_tag

	property BagPassengerId
		dataType: string

		backingConfiguration
			valueColumn: bags.passenger_id

	property BagInboundFlightId
		dataType: string

		backingConfiguration
			valueColumn: bags.inbound_flight_id

	property BagOnwardFlightId
		dataType: string

		backingConfiguration
			valueColumn: bags.onward_flight_id
