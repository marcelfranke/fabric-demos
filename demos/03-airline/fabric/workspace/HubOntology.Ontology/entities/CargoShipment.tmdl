/// Freight that has to be moved from an arriving flight to a departing flight.
entity CargoShipment
	lineageTag: 9c2e1b43-5d4e-4b1f-8a30-1b2c3d4e0207
	backingTable: cargo_shipments
	keyProperty: ShipmentId

	property ShipmentId
		dataType: string

		backingConfiguration
			valueColumn: cargo_shipments.shipment_id

	property ShipmentInboundFlightId
		dataType: string

		backingConfiguration
			valueColumn: cargo_shipments.inbound_flight_id

	property ShipmentOnwardFlightId
		dataType: string

		backingConfiguration
			valueColumn: cargo_shipments.onward_flight_id

	/// True when the shipment has to stay inside a temperature range.
	property TemperatureControlled
		dataType: boolean

		backingConfiguration
			valueColumn: cargo_shipments.temperature_controlled

	/// The shortest transfer time the shipment needs, in minutes.
	property MinimumTransferMinutes
		dataType: int64

		backingConfiguration
			valueColumn: cargo_shipments.min_transfer_min
